{
    "version": "2.0.0",
    "tasks": [
        {
            // Ctrl+Shift+B. Real compiler errors, with -Werror, land in the
            // Problems panel - IntelliSense squiggles are a fast approximation,
            // this is the source of truth.
            "label": "build",
            "type": "shell",
            "command": "cmake --build build -j",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "test",
            "type": "shell",
            "command": "./build/gemm_tests && ./build/unit_tests",
            "dependsOn": "build",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
